# Optional. If OmniRoute or FreeLLMAPI is running locally, jobs can use it.
# OmniRoute default: http://127.0.0.1:20128/v1
# FreeLLMAPI default: http://127.0.0.1:3001/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=auto

MEETING_NOTES_DB_PATH=
MEETING_ME_ALIASES=Yousef Khalifa,Yusuf,Yousef

# Azure DevOps code read scope. Used only to clone a linked repository.
AZURE_DEVOPS_PAT=

HOST=127.0.0.1
PORT=8000

