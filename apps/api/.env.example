OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama (RTX 4090). Leave default unless Ollama is on another port.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# DGX Spark LiteLLM gateway on the office LAN. Ollama on Spark is not open from here.
# Use your engineer key (sk-…), not the shared admin master key.
SPARK_BASE_URL=http://192.168.100.129:4000/v1
SPARK_API_KEY=
# Spark 2 is a second box. Spark 1’s engineer key is rejected here — set SPARK2_API_KEY.
SPARK2_BASE_URL=http://192.168.100.127:4000/v1
SPARK2_API_KEY=

# Optional. If OmniRoute or FreeLLMAPI is running locally, jobs can use it.
# OmniRoute default: http://127.0.0.1:20128/v1
# FreeLLMAPI default: http://127.0.0.1:3001/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=auto

MEETING_NOTES_DB_PATH=
MEETING_ME_ALIASES=Yousef Khalifa,Yusuf,Yousef

# Azure DevOps code read scope. Used only to clone a linked repository.
# Add the token, then press Sync in the list. A restart is not required.
AZURE_DEVOPS_PAT=

HOST=127.0.0.1
PORT=8000

# Optional. If set, phone and remote clients must send Authorization: Bearer <token>
# (WebSocket: ?token=). Leave empty for local desktop-only use.
FOUNDRY_TOKEN=

